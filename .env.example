# zenith reads these on the server only. Copy to .env.local and fill in what you use.
# Keys can also be pasted from the Data sources page (/reglages), which writes .env.local for you.
# Everything personal (projects, location, subscriptions…) lives in zenith.config.json, not here.

# Railway account token (Account Settings → Tokens): deployments, HTTP traffic, monthly bill.
RAILWAY_TOKEN=
# RevenueCat secret v2 key, read-only: MRR, revenue, subscribers (projects[].revenuecat in the config).
REVENUECAT_API_KEY=
# OpenRouter key: credit balance and spending.
OPENROUTER_API_KEY=

# GITHUB_TOKEN=          # otherwise: `gh auth token`
# OBSIDIAN_VAULT=        # otherwise: obsidian.vault in the config, then the vault open in Obsidian
# OBSIDIAN_EXPORT=0      # do not write zenith's summary into the vault
# PROJECTS_ROOT=         # when projectsRoot is not set in the config; default: the parent folder of zenith/
# ZENITH_CONFIG=         # otherwise: zenith.config.json next to package.json
# TRANSIT_STOP=          # overrides transit.stop in the config (Swiss stops only)
# CLAUDE_HOME=           # otherwise: ~/.claude
# CODEX_HOME=            # otherwise: ~/.codex
