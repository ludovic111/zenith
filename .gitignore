# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.data/

# Compiled Mac app, publication staging
.build/

# Agent context generated from your data
/context/

# Your data and your own extensions: never committed
/perso/
/zenith.config.json

# zenith code (code/): dependencies, builds and local dev state
/code/**/node_modules/
/code/apps/*/dist/
/code/packages/*/dist/
/code/.t3/
/code/.vite-hooks/_/
/.t3/
