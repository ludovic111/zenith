{
  "name": "zenith",
  "version": "0.1.0",
  "private": true,
  "description": "A private sky over your projects and your day: a local dashboard, plus zenith code, a coding workspace for Claude Code and Codex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ludovic111/zenith.git"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4748",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4747",
    "lint": "eslint",
    "mac:install": "bash scripts/mac/install.sh",
    "mac:uninstall": "bash scripts/mac/uninstall.sh",
    "config:schema": "node --no-warnings scripts/config-schema.mts",
    "privacy": "node scripts/privacy-check.mjs",
    "code:install": "cd code && npx -y pnpm@11.10.0 install",
    "code:build": "npm run code:install && cd code && npx -y pnpm@11.10.0 run build",
    "code:dev": "cd code && npx -y pnpm@11.10.0 run dev --home-dir \"$HOME/.zenith/code-dev\"",
    "code:sync": "bash scripts/code-sync.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@number-flow/react": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "simple-icons": "^16.33.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
