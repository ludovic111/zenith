        "exportDir": {
          "default": "zenith",
          "type": "string"
        }
      }
    },
    "mac": {
      "default": {
        "bundleId": "dev.zenith.app"
      },
      "type": "object",
      "properties": {
        "bundleId": {
          "default": "dev.zenith.app",
          "type": "string"
        }
      }
    },
    "code": {
      "default": {
        "enabled": true,
        "port": 4749
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "port": {
          "default": 4749,
          "type": "number"
        },
        "home": {
          "type": "string"
        }
      }
    },
    "updates": {
      "default": {
        "auto": true
      },
      "type": "object",
      "properties": {
        "auto": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "agent": {
      "default": {
        "enabled": true,
        "home": "~/.zenith/life",
        "name": "zenith",
        "improve": "propose",
        "provider": "claude",
        "routines": [],
        "bots": [],
        "mcp": {},
        "gateway": {}
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "home": {
          "default": "~/.zenith/life",
          "type": "string"
        },
        "improve": {
          "default": "propose",
          "type": "string",
          "enum": [
            "propose",
            "ship"
          ]
        },
        "name": {
          "default": "zenith",
          "type": "string"
        },
        "shape": {
          "type": "string",
          "enum": [
            "circle",
            "blob",
            "square",
            "pill",
            "hexagon",
            "triangle",
            "heart",
            "flower"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accessory": {
          "type": "string",
          "enum": [
            "none",
            "antenna",
            "sprout",
            "star",
            "bow",
            "crown",
            "glasses",
            "headset"
          ]
        },
        "provider": {
          "default": "claude",
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        "model": {
          "type": "string"
        },
        "routines": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "name": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "days": {
                "default": [
                  1,
                  2,
                  3,
                  4,
                  5,
                  6,
                  7
                ],
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                }
              },
              "every": {
                "type": "string",
                "pattern": "^\\d+(m|h)$"
              },
              "from": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "until": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "on": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "down",
                    "payment",
                    "birthday",
                    "sale",
                    "reply",
                    "civic",
                    "ci",
                    "refresh"
                  ]
                }
              },
              "task": {
                "type": "string",
                "enum": [
                  "refresh-life",
                  "improve-zenith"
                ]
              },
              "skill": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "bot": {
                "type": "string"
              },
              "project": {
                "type": "string"
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "bots": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "name": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "shape": {
                "type": "string",
                "enum": [
                  "circle",
                  "blob",
                  "square",
                  "pill",
                  "hexagon",
                  "triangle",
                  "heart",
                  "flower"
                ]
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accessory": {
                "type": "string",
                "enum": [
                  "none",
                  "antenna",
                  "sprout",
                  "star",
                  "bow",
                  "crown",
                  "glasses",
                  "headset"
                ]
              },
              "emoji": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "claude",
                  "codex"
                ]
              },
              "model": {
                "type": "string"
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "role"
            ]
          }
        },
        "mcp": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[\\w-]+$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "command"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "headers": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "url"
                ]
              }
            ]
          }
        },
        "gateway": {
          "default": {},
          "type": "object",
          "properties": {
            "telegram": {
              "type": "object",
              "properties": {
                "chats": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "pattern": "^-?\\d+$"
                      }
                    ]
                  }
                },
                "target": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
