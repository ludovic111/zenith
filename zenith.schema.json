                  "required": [
                    "label",
                    "value"
                  ]
                }
              },
              "services": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "brand": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "x",
                            "instagram",
                            "youtube",
                            "tiktok",
                            "github",
                            "telegram",
                            "linkedin",
                            "bluesky",
                            "mastodon",
                            "threads"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "appstore",
                            "googleplay",
                            "railway",
                            "supabase",
                            "revenuecat",
                            "openrouter",
                            "solana",
                            "gmail",
                            "apple",
                            "vercel",
                            "cloudflare",
